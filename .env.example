# DineSense Feedback Environment Configuration
# Copy to .env for local development. Never commit real secrets.

# Node / Express Live Server
PORT=3000
NODE_ENV=development
JWT_SECRET_KEY="replace_with_secure_random_64_char_secret"
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS="http://localhost:3000"
SQLITE_DB_PATH="./dinesense.db"
RETENTION_DAYS=90
INFERENCE_PROVIDER="demo-v1"

# Python FastAPI & PostgreSQL (for Python backend / Docker deployment)
DATABASE_URL="postgresql+psycopg2://dinesense:dinesense_password@localhost:5432/dinesense_db"
APP_ENV="development"
MODEL_PATH="./ml/models/mobilenetv2_cue_v1.onnx"

# Optional AI Studio Server Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
